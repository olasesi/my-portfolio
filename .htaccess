# ============================================================
# ROOT .htaccess — cPanel / Apache (ahmed-olusesi.com)
# Funnels all browser traffic into public/
# ============================================================

Options -Indexes

RewriteEngine On
RewriteBase /

# ── 1. Block sensitive project files ─────────────────────
RewriteRule ^(composer\.(json|lock)|\.env.*|vendor(/.*)?|src(/.*)?)$ - [F,L]

# ── 2. Already inside public/ — stop, prevent loop ───────
RewriteCond %{REQUEST_URI} ^/public/ [NC]
RewriteRule ^ - [L]

# ── 3. Forward everything else into public/ ──────────────
RewriteRule ^(.*)$ public/$1 [L]
# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
